
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RevisAI",
  "version": "0.1.0",
  "identifier": "com.revisai.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1",
      "cwd": "..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RevisAI",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
